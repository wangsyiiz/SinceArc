<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX 清单模板（docs/distribution.md §13）。

  下面这几处的值由 CI 在打包时代入（release.yml 的「打 MSIX」步骤）：
  包身份名 / 发布者 DN / 发布者显示名 / 应用名 / 四段版本号。
  注意别在注释里写占位符字面量 —— 替换是纯字符串替换，注释里的也会被换掉。

  Publisher 有两种口径，别混：
    · 未签名测试包：必须以 OID 后缀结尾（MS 文档「Create an unsigned MSIX package」），
      即 CN=… + ", OID.2.25.311729368913984317654407730594956997722=1"，
      否则 Add-AppxPackage -AllowUnsigned 报 0x80073D2C「发布者不在未签名命名空间」；
    · 商店包：提交时由 Store 认证重签，Publisher 必须等于 Partner Center 给出的值，且**不带** OID。

  为什么是 FullTrust + mediumIL：SinceArc 要起 gh / wsl / agent 这类外部进程，
  还要读写用户自选的项目目录 —— 必须在 AppContainer 之外跑，
  所以 EntryPoint=Windows.FullTrustApplication + rescap:runFullTrust。

  数据落点：full trust（mediumIL）**不做文件重定向**（MS 文档把 AppData 重定向那节标为
  「applies only to virtualized apps」），所以商店版与便携版共用同一个
  %APPDATA%\com.sincearc.app\ —— 实测互通（docs/distribution.md §13.3）。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>__DISPLAY_NAME__</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>ACP 客户端：把本机的 coding agent 接成可对话的桌面应用</Description>
  </Properties>

  <Dependencies>
    <!-- Win10 2004 起；WebView2 Evergreen 在 Win11 与较新 Win10 自带 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application
      Id="SinceArc"
      Executable="SinceArc.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="packagedClassicApp">
      <uap:VisualElements
        DisplayName="__DISPLAY_NAME__"
        Description="ACP 客户端：把本机的 coding agent 接成可对话的桌面应用"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <!-- 全信任桌面应用：需要它才能起外部进程、访问用户自选目录 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
