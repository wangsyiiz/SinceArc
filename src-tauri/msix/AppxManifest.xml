<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX 清单模板（docs/distribution.md §13）。

  __TOKEN__ 由 .github/workflows/release.yml 在打包时替换：
    __IDENTITY_NAME__         包身份名（Store 版必须与 Partner Center 里预留的名字一致）
    __PUBLISHER__             发布者 DN，必须与签名证书同名（Store 认证会重签）
    __PUBLISHER_DISPLAY_NAME__ 列表里显示的发布者名
    __DISPLAY_NAME__          列表里显示的应用名
    __VERSION__               四段版本号（x.y.z → x.y.z.0）

  为什么是 FullTrust + mediumIL：SinceArc 要起 gh / wsl / agent 这类外部进程，
  还要读写用户自选的项目目录 —— 必须在 AppContainer 之外跑，
  所以 EntryPoint=Windows.FullTrustApplication + rescap:runFullTrust。
  代价：写入仍会被重定向到按用户的受管目录（%LOCALAPPDATA%\Packages\<PFN>\...），
  已有 %APPDATA%\com.sincearc.app 的数据不会自动跟过去。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="__VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>__DISPLAY_NAME__</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>ACP 客户端：把本机的 coding agent 接成可对话的桌面应用</Description>
  </Properties>

  <Dependencies>
    <!-- Win10 2004 起；WebView2 Evergreen 在 Win11 与较新 Win10 自带 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application
      Id="SinceArc"
      Executable="SinceArc.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="packagedClassicApp">
      <uap:VisualElements
        DisplayName="__DISPLAY_NAME__"
        Description="ACP 客户端：把本机的 coding agent 接成可对话的桌面应用"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <!-- 全信任桌面应用：需要它才能起外部进程、访问用户自选目录 -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
